[Unit]
Description=LarpCron
After=network-online.target

[Service]
# deploy/install.sh rewrites User and the paths for your machine
User=pi
WorkingDirectory=/home/pi/LarpCron
ExecStart=/home/pi/LarpCron/.venv/bin/python -m larpcron --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
